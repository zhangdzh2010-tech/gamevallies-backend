// Gamevallies Database Schema
// MySQL 8.0 + Prisma ORM

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== 用户系统 ====================

enum AuthProvider {
  email
  phone
  wechat
  google
  apple
}

enum UserRole {
  user
  creator
  moderator
  admin
}

enum SubscriptionPeriod {
  monthly
  yearly
}

enum UserSubscriptionStatus {
  active
  expired
  cancelled
}

enum SubscriptionOrderStatus {
  pending
  paid
  failed
  refunded
  canceled
}

enum GameAccessGrantSource {
  none
  free_quota
  subscription_quota
  subscription_unlock
}

enum GenerationTaskType {
  pipeline_run
  pipeline_iterate
}

enum GenerationTaskStatus {
  queued
  running
  succeeded
  failed
  canceled
  timed_out
}

enum GenerationTaskEventType {
  status
  progress
  llm_call
  note
  error
}

enum LLMProviderType {
  openai_compatible
  anthropic
}

model User {
  id             String       @id @default(uuid()) @db.VarChar(36)
  username       String       @unique @db.VarChar(32)
  displayName    String?      @map("display_name") @db.VarChar(64)
  avatarUrl      String?      @map("avatar_url")
  email          String?      @unique @db.VarChar(255)
  phone          String?      @unique @db.VarChar(20)
  passwordHash   String?      @map("password_hash")
  authProvider   AuthProvider @default(email) @map("auth_provider")
  wxOpenId       String?      @unique @map("wx_open_id")
  wxUnionId      String?      @map("wx_union_id")
  role           UserRole     @default(user)
  isPro          Boolean      @default(false) @map("is_pro")
  proExpires     DateTime?    @map("pro_expires") @db.DateTime(3)
  bio            String?      @db.VarChar(200)
  followerCount  Int          @default(0) @map("follower_count")
  followingCount Int          @default(0) @map("following_count")
  gameCount      Int          @default(0) @map("game_count")
  totalPlays     BigInt       @default(0) @map("total_plays")
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  // Relations
  games              Game[]              @relation("GameAuthor")
  socialInteractions SocialInteraction[] @relation("UserInteractions")
  comments           Comment[]           @relation("UserComments")
  earnings           CreatorEarning[]    @relation("CreatorEarnings")
  notifications      Notification[]      @relation("UserNotifications")
  refreshTokens      RefreshToken[]      @relation("UserRefreshTokens")
  followingRelations UserFollow[]        @relation("FollowerUser")
  followerRelations  UserFollow[]        @relation("FollowingUser")
  quota              UserQuota?
  subscriptions      UserSubscription[]
  subscriptionOrders SubscriptionOrder[]
  generationTasks    GenerationTask[]    @relation("UserGenerationTasks")
  generationTaskEvents GenerationTaskEvent[] @relation("UserGenerationTaskEvents")
  llmCallLogs        LlmCallLog[]        @relation("UserLlmCallLogs")
  generationArtifacts GenerationArtifact[] @relation("UserGenerationArtifacts")
  creationSessions   GameCreationSession[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  token     String    @unique @db.VarChar(500)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)

  user User @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ==================== 游戏系统 ====================

enum GameStatus {
  draft
  generating
  review
  published
  banned
  failed
}

model Game {
  id           String     @id @default(uuid()) @db.VarChar(36)
  authorId     String     @map("author_id") @db.VarChar(36)
  title        String     @db.VarChar(64)
  description  String?    @db.Text
  // H.5.1 - Clean, user-facing idea (the user's original tagline) for C-end display.
  // `description` may still hold the LLM-expanded prompt for pipeline compatibility;
  // presenters should prefer `userIdea` and only fall back to a sanitized
  // `description` when this field is empty (legacy rows).
  userIdea     String?    @map("user_idea") @db.Text
  slug         String?    @unique @db.VarChar(128)
  status       GameStatus @default(draft)
  failedStage  String?    @map("failed_stage") @db.VarChar(64)
  failedReason String?    @map("failed_reason") @db.Text
  retryCount   Int        @default(0) @map("retry_count")
  lastErrorAt  DateTime?  @map("last_error_at") @db.DateTime(3)
  gameType     String?    @map("game_type") @db.VarChar(32)
  tags         Json       @default("[]")
  forkedFrom   String?    @map("forked_from") @db.VarChar(36)
  forkDepth    Int        @default(0) @map("fork_depth")
  codeBundleId String?    @map("code_bundle_id") @db.VarChar(255)
  version      Int        @default(1)
  thumbnailUrl String?    @map("thumbnail_url")
  playCount    BigInt     @default(0) @map("play_count")
  likeCount    BigInt     @default(0) @map("like_count")
  forkCount    BigInt     @default(0) @map("fork_count")
  commentCount Int        @default(0) @map("comment_count")
  avgPlayTime  Float      @default(0) @map("avg_play_time")
  qualityScore   Float      @default(0) @map("quality_score")
  visibility     String     @default("public") @db.VarChar(16)
  allowComments  Boolean    @default(true) @map("allow_comments")
  allowFork      Boolean    @default(true) @map("allow_fork")
  canPlay        Boolean    @default(true) @map("can_play")
  requireSubscription Boolean @default(false) @map("require_subscription")
  accessGrantSource GameAccessGrantSource @default(none) @map("access_grant_source")
  accessGrantSubscriptionId String? @map("access_grant_subscription_id") @db.VarChar(36)
  createdAt      DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  publishedAt    DateTime?  @map("published_at") @db.DateTime(3)

  // Relations
  author             User                @relation("GameAuthor", fields: [authorId], references: [id])
  parentGame         Game?               @relation("GameForks", fields: [forkedFrom], references: [id])
  forks              Game[]              @relation("GameForks")
  comments           Comment[]           @relation("GameComments")
  earnings           CreatorEarning[]    @relation("GameEarnings")
  bundles            GameBundle[]        @relation("GameBundles")
  generationTasks    GenerationTask[]    @relation("GameGenerationTasks")
  generationTaskEvents GenerationTaskEvent[] @relation("GameGenerationTaskEvents")
  llmCallLogs        LlmCallLog[]        @relation("GameLlmCallLogs")
  generationArtifacts GenerationArtifact[] @relation("GameGenerationArtifacts")

  @@index([authorId])
  @@index([gameType, qualityScore])
  @@index([forkedFrom])
  @@index([status, publishedAt])
  @@index([status, playCount])
  @@map("games")
}

model UserQuota {
  id             String   @id @default(uuid()) @db.VarChar(36)
  userId         String   @unique @map("user_id") @db.VarChar(36)
  totalFreeQuota Int      @default(5) @map("total_free_quota")
  usedFreeQuota  Int      @default(0) @map("used_free_quota")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_quotas")
}

model SubscriptionPlan {
  id           String             @id @db.VarChar(64)
  name         String             @db.VarChar(128)
  description  String?            @db.VarChar(255)
  price        Int
  currency     String             @default("CNY") @db.VarChar(3)
  period       SubscriptionPeriod
  quota        Int
  features     Json               @default("[]")
  recommended  Boolean            @default(false)
  badge        String?            @db.VarChar(32)
  sortOrder    Int                @default(0) @map("sort_order")
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  subscriptions UserSubscription[]
  orders        SubscriptionOrder[]

  @@index([active, sortOrder])
  @@map("subscription_plans")
}

model UserSubscription {
  id              String                 @id @default(uuid()) @db.VarChar(36)
  userId          String                 @map("user_id") @db.VarChar(36)
  planId          String                 @map("plan_id") @db.VarChar(64)
  status          UserSubscriptionStatus @default(active)
  startedAt       DateTime               @map("started_at") @db.DateTime(3)
  expiresAt       DateTime               @map("expires_at") @db.DateTime(3)
  usedThisPeriod  Int                    @default(0) @map("used_this_period")
  quotaThisPeriod Int                    @map("quota_this_period")
  autoRenew       Boolean                @default(false) @map("auto_renew")
  createdAt       DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId, status, expiresAt])
  @@map("user_subscriptions")
}

model SubscriptionOrder {
  id                  String                  @id @db.VarChar(64)
  userId              String                  @map("user_id") @db.VarChar(36)
  planId              String                  @map("plan_id") @db.VarChar(64)
  amount              Int
  currency            String                  @default("CNY") @db.VarChar(3)
  status              SubscriptionOrderStatus @default(pending)
  provider            String                  @default("wechat_pay") @db.VarChar(32)
  outTradeNo          String                  @unique @map("out_trade_no") @db.VarChar(64)
  paymentId           String?                 @map("payment_id") @db.VarChar(128)
  prepayId            String?                 @map("prepay_id") @db.VarChar(128)
  gameIdToUnlock      String?                 @map("game_id_to_unlock") @db.VarChar(36)
  description         String?                 @db.VarChar(255)
  paymentPayload      Json?                   @map("payment_payload")
  paymentResponse     Json?                   @map("payment_response")
  paidAt              DateTime?               @map("paid_at") @db.DateTime(3)
  expiresAt           DateTime?               @map("expires_at") @db.DateTime(3)
  createdAt           DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId, status, createdAt])
  @@map("subscription_orders")
}

// ==================== 游戏代码存储（原 MongoDB game_bundles） ====================

model GameBundle {
  id             String   @id @default(uuid()) @db.VarChar(36)
  gameId         String   @map("game_id") @db.VarChar(36)
  version        Int      @default(1)
  htmlCode       String   @map("html_code") @db.LongText
  cssCode        String?  @map("css_code") @db.LongText
  jsCode         String?  @map("js_code") @db.LongText
  spec           Json?
  aiConversation Json?    @map("ai_conversation")
  generationMeta Json?    @map("generation_meta")
  metadata       Json?
  previewUrl     String?  @map("preview_url")
  codeSizeBytes  Int?     @map("code_size_bytes")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  game Game @relation("GameBundles", fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, version], name: "uk_game_version")
  @@index([gameId])
  @@index([createdAt])
  @@map("game_bundles")
}

model GameCreationSession {
  id               String   @id @default(uuid()) @db.VarChar(36)
  userId           String   @map("user_id") @db.VarChar(36)
  status           String   @default("collecting") @db.VarChar(32)
  entryMode        String   @default("create") @map("entry_mode") @db.VarChar(32)
  initialPrompt    String   @map("initial_prompt") @db.LongText
  titleDraft       String?  @map("title_draft") @db.VarChar(64)
  regionHint       String?  @map("region_hint") @db.VarChar(32)
  locale           String?  @db.VarChar(16)
  aiState          String?  @map("ai_state") @db.VarChar(32)
  revision         Int      @default(1)
  slotState        Json     @map("slot_state")
  missingRequired  Json     @map("missing_required")
  skippedSlots     Json     @map("skipped_slots")
  currentQuestion  Json?    @map("current_question")
  conversation     Json     @default("[]")
  generatedGameId  String?  @map("generated_game_id") @db.VarChar(36)
  generationTaskId String?  @map("generation_task_id") @db.VarChar(36)
  sourceGameId     String?  @map("source_game_id") @db.VarChar(36)
  questionBudget   Int      @default(4) @map("question_budget")
  questionsAsked   Int      @default(0) @map("questions_asked")
  expiresAt        DateTime? @map("expires_at") @db.DateTime(3)
  lastClientRequestId String? @map("last_client_request_id") @db.VarChar(64)
  lastClientMessageId String? @map("last_client_message_id") @db.VarChar(64)
  lastGenerateKey  String?  @map("last_generate_key") @db.VarChar(64)
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, updatedAt])
  @@index([generatedGameId])
  @@index([generationTaskId])
  @@map("game_creation_sessions")
}

// ==================== 游戏模板（原 MongoDB game_templates） ====================

model GameTemplate {
  id         String   @id @default(uuid()) @db.VarChar(36)
  templateId String   @unique @map("template_id") @db.VarChar(255)
  gameType   String?  @map("game_type") @db.VarChar(32)
  content    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([gameType])
  @@map("game_templates")
}

// ==================== LLM 网关与异步任务 ====================

model CloudProviderAccount {
  id                       String                 @id @default(uuid()) @db.VarChar(36)
  vendor                   String                 @db.VarChar(32)
  accountKey               String                 @unique @map("account_key") @db.VarChar(64)
  displayName              String                 @map("display_name") @db.VarChar(128)
  enabled                  Boolean                @default(true)
  credentialMode           String                 @default("env_secret") @map("credential_mode") @db.VarChar(32)
  defaultRegistry          String?                @map("default_registry") @db.VarChar(255)
  defaultRegistryNamespace String?                @map("default_registry_namespace") @db.VarChar(128)
  defaultVpcId             String?                @map("default_vpc_id") @db.VarChar(128)
  defaultSubnetId          String?                @map("default_subnet_id") @db.VarChar(128)
  defaultSecurityGroupId   String?                @map("default_security_group_id") @db.VarChar(128)
  syncedAt                 DateTime?              @map("synced_at") @db.DateTime(3)
  createdAt                DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  regions                  CloudRegionCatalog[]
  aiEngineRegionTargets    AiEngineRegionTarget[]

  @@index([vendor, enabled])
  @@map("cloud_provider_accounts")
}

model CloudRegionCatalog {
  id              String                 @id @default(uuid()) @db.VarChar(36)
  accountId       String                 @map("account_id") @db.VarChar(36)
  vendor          String                 @db.VarChar(32)
  regionCode      String                 @map("region_code") @db.VarChar(64)
  regionName      String                 @map("region_name") @db.VarChar(64)
  regionGroup     String?                @map("region_group") @db.VarChar(32)
  vcrSupported    Boolean                @default(true) @map("vcr_supported")
  vefaasSupported Boolean                @default(true) @map("vefaas_supported")
  apigSupported   Boolean                @default(true) @map("apig_supported")
  deploySupported Boolean                @default(true) @map("deploy_supported")
  enabled         Boolean                @default(true)
  syncedAt        DateTime               @default(now()) @map("synced_at") @db.DateTime(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  account         CloudProviderAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  aiEngineRegionTargets AiEngineRegionTarget[]

  @@unique([accountId, regionCode], name: "cloud_region_catalog_account_id_region_code_key")
  @@index([vendor, enabled])
  @@map("cloud_region_catalog")
}

model AiEngineRegionTarget {
  id                 String                 @id @default(uuid()) @db.VarChar(36)
  accountId          String                 @map("account_id") @db.VarChar(36)
  regionCatalogId    String                 @map("region_catalog_id") @db.VarChar(36)
  vendor             String                 @db.VarChar(32)
  cloudRegionCode    String                 @map("cloud_region_code") @db.VarChar(64)
  executionRegion    String                 @map("execution_region") @db.VarChar(32)
  displayName        String                 @map("display_name") @db.VarChar(128)
  functionName       String                 @map("function_name") @db.VarChar(128)
  registry           String                 @db.VarChar(255)
  registryNamespace  String                 @map("registry_namespace") @db.VarChar(128)
  imageRepository    String                 @map("image_repository") @db.VarChar(128)
  serviceRegionEnv   String                 @map("service_region_env") @db.VarChar(32)
  aiEngineUrl        String?                @map("ai_engine_url") @db.VarChar(255)
  deployEnabled      Boolean                @default(true) @map("deploy_enabled")
  deployStatus       String                 @default("pending") @map("deploy_status") @db.VarChar(32)
  lastRevision       String?                @map("last_revision") @db.VarChar(64)
  lastImageTag       String?                @map("last_image_tag") @db.VarChar(128)
  lastReleaseStatus  String?                @map("last_release_status") @db.VarChar(64)
  lastDeployError    String?                @map("last_deploy_error") @db.Text
  lastDeployedAt     DateTime?              @map("last_deployed_at") @db.DateTime(3)
  createdAt          DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  account            CloudProviderAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  regionCatalog      CloudRegionCatalog     @relation(fields: [regionCatalogId], references: [id], onDelete: Cascade)
  providers          LlmGatewayProvider[]

  @@unique([executionRegion], name: "ai_engine_region_targets_execution_region_key")
  @@index([deployEnabled, deployStatus])
  @@index([vendor, cloudRegionCode])
  @@map("ai_engine_region_targets")
}

model LlmGatewayProvider {
  id               String          @id @default(uuid()) @db.VarChar(36)
  name             String          @db.VarChar(64)
  providerType     LLMProviderType @map("provider_type")
  regionTargetId   String?         @map("region_target_id") @db.VarChar(36)
  cloudVendor      String?         @map("cloud_vendor") @db.VarChar(32)
  cloudRegionCode  String?         @map("cloud_region_code") @db.VarChar(64)
  region           String          @default("cn_shanghai") @db.VarChar(32)
  baseUrl          String          @map("base_url") @db.VarChar(255)
  apiKey           String          @map("api_key") @db.Text
  model            String          @db.VarChar(128)
  fastModel        String?         @map("fast_model") @db.VarChar(128)
  requestTimeoutS  Int             @default(1800) @map("request_timeout_s")
  connectTimeoutS  Int             @default(1800) @map("connect_timeout_s")
  enabled          Boolean         @default(true)
  priority         Int             @default(100)
  description      String?         @db.VarChar(255)
  extraConfig      Json?           @map("extra_config")
  capabilityFlags  Json?           @default("{}") @map("capability_flags")
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  stepRoutes       LlmStepRoute[]
  llmCallLogs      LlmCallLog[]
  testRecords      LlmGatewayTestRecord[]
  regionTarget     AiEngineRegionTarget? @relation(fields: [regionTargetId], references: [id], onDelete: SetNull)

  @@index([enabled, region, priority])
  @@index([providerType, region])
  @@index([regionTargetId])
  @@map("llm_gateway_providers")
}

model LlmStepRoute {
  id                  String             @id @default(uuid()) @db.VarChar(36)
  stepKey             String             @map("step_key") @db.VarChar(64)
  region              String             @default("cn_shanghai") @db.VarChar(32)
  providerId          String             @map("provider_id") @db.VarChar(36)
  fallbackProviderIds Json               @default("[]") @map("fallback_provider_ids")
  modelOverride       String?            @map("model_override") @db.VarChar(128)
  fastModelOverride   String?            @map("fast_model_override") @db.VarChar(128)
  requestTimeoutS     Int?               @map("request_timeout_s")
  connectTimeoutS     Int?               @map("connect_timeout_s")
  enabled             Boolean            @default(true)
  createdAt           DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  provider            LlmGatewayProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([stepKey, region], name: "llm_step_routes_step_key_region_key")
  @@index([enabled, region])
  @@index([providerId])
  @@map("llm_step_routes")
}

model LlmStepCatalog {
  id          String    @id @default(uuid()) @db.VarChar(36)
  stepKey     String    @unique @map("step_key") @db.VarChar(64)
  stepOrder   Int       @map("step_order")
  stageLabel  String?   @map("stage_label") @db.VarChar(64)
  displayName String    @map("display_name") @db.VarChar(128)
  description String?   @db.VarChar(255)
  outputClass String?   @default("medium_structured") @map("output_class") @db.VarChar(32)
  minOutputTokens Int?  @map("min_output_tokens")
  maxOutputTokens Int?  @map("max_output_tokens")
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([enabled, stepOrder])
  @@map("llm_step_catalog")
}

model LlmGatewayTestRecord {
  id                String             @id @default(uuid()) @db.VarChar(36)
  providerId        String             @map("provider_id") @db.VarChar(36)
  success           Boolean
  region            String             @default("cn_shanghai") @db.VarChar(32)
  resolvedEndpoint  String?            @map("resolved_endpoint") @db.VarChar(255)
  model             String?            @db.VarChar(128)
  latencyMs         Int?               @map("latency_ms")
  httpStatus        Int?               @map("http_status")
  errorMessage      String?            @map("error_message") @db.Text
  testedAt          DateTime           @default(now()) @map("tested_at") @db.DateTime(3)

  provider          LlmGatewayProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, testedAt])
  @@map("llm_gateway_test_records")
}

model GenerationTask {
  id                   String                @id @default(uuid()) @db.VarChar(36)
  gameId               String                @map("game_id") @db.VarChar(36)
  userId               String                @map("user_id") @db.VarChar(36)
  taskType             GenerationTaskType    @map("task_type")
  region               String                @default("cn_shanghai") @db.VarChar(32)
  status               GenerationTaskStatus  @default(queued)
  timeoutS             Int                   @map("timeout_s")
  version              Int?
  pipelineVersion      String?               @map("pipeline_version") @db.VarChar(16)
  promptBundleId       String?               @map("prompt_bundle_id") @db.VarChar(64)
  promptBundleVersion  Int?                  @map("prompt_bundle_version")
  runtimeProfile       String?               @map("runtime_profile") @db.VarChar(64)
  contractVersion      String?               @map("contract_version") @db.VarChar(32)
  failureFamily        String?               @map("failure_family") @db.VarChar(64)
  primaryArtifactId    String?               @map("primary_artifact_id") @db.VarChar(36)
  cancelRequested      Boolean               @default(false) @map("cancel_requested")
  upstreamTaskId       String?               @map("upstream_task_id") @db.VarChar(64)
  progressStage        String?               @map("progress_stage") @db.VarChar(64)
  progressPct          Int?                  @map("progress_pct")
  progressMessage      String?               @map("progress_message") @db.VarChar(255)
  failedStage          String?               @map("failed_stage") @db.VarChar(64)
  errorMessage         String?               @map("error_message") @db.Text
  retryCount           Int                   @default(0) @map("retry_count")
  fallback             String?               @db.VarChar(64)
  wsChannel            String                @map("ws_channel") @db.VarChar(128)
  previewUrl           String?               @map("preview_url") @db.VarChar(255)
  gatewayConfigVersion Int?                  @map("gateway_config_version")
  routeSnapshot        Json?                 @map("route_snapshot")
  resultSummary        Json?                 @map("result_summary")
  metadata             Json?
  startedAt            DateTime?             @map("started_at") @db.DateTime(3)
  completedAt          DateTime?             @map("completed_at") @db.DateTime(3)
  createdAt            DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  game                 Game                  @relation("GameGenerationTasks", fields: [gameId], references: [id], onDelete: Cascade)
  user                 User                  @relation("UserGenerationTasks", fields: [userId], references: [id], onDelete: Cascade)
  events               GenerationTaskEvent[]
  llmCallLogs          LlmCallLog[]
  artifacts            GenerationArtifact[]  @relation("TaskGenerationArtifacts")

  @@index([gameId, createdAt])
  @@index([region, status, updatedAt])
  @@index([userId, status, createdAt])
  @@index([status, updatedAt])
  @@index([pipelineVersion, status, updatedAt])
  @@index([runtimeProfile, status, createdAt])
  @@index([failureFamily, createdAt])
  @@map("generation_tasks")
}

model GenerationTaskEvent {
  id           String                  @id @default(uuid()) @db.VarChar(36)
  taskId       String                  @map("task_id") @db.VarChar(36)
  gameId       String                  @map("game_id") @db.VarChar(36)
  userId       String                  @map("user_id") @db.VarChar(36)
  eventType    GenerationTaskEventType @map("event_type")
  stage        String?                 @db.VarChar(64)
  percentage   Int?
  message      String                  @db.VarChar(255)
  details      Json?
  createdAt    DateTime                @default(now()) @map("created_at") @db.DateTime(3)

  task         GenerationTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  game         Game                    @relation("GameGenerationTaskEvents", fields: [gameId], references: [id], onDelete: Cascade)
  user         User                    @relation("UserGenerationTaskEvents", fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([gameId, createdAt])
  @@index([userId, createdAt])
  @@map("generation_task_events")
}

model LlmCallLog {
  id                   String             @id @default(uuid()) @db.VarChar(36)
  taskId               String?            @map("task_id") @db.VarChar(36)
  gameId               String             @map("game_id") @db.VarChar(36)
  userId               String             @map("user_id") @db.VarChar(36)
  stage                String             @db.VarChar(64)
  stepKey              String             @map("step_key") @db.VarChar(64)
  providerId           String?            @map("provider_id") @db.VarChar(36)
  providerName         String?            @map("provider_name") @db.VarChar(64)
  providerType         String?            @map("provider_type") @db.VarChar(32)
  region               String?            @db.VarChar(32)
  model                String?            @db.VarChar(128)
  requestTimeoutS      Int?               @map("request_timeout_s")
  connectTimeoutS      Int?               @map("connect_timeout_s")
  latencyMs            Int?               @map("latency_ms")
  httpStatus           Int?               @map("http_status")
  inputTokens          Int?               @map("input_tokens")
  outputTokens         Int?               @map("output_tokens")
  totalTokens          Int?               @map("total_tokens")
  outputClass          String?            @map("output_class") @db.VarChar(32)
  isPrimaryProvider    Boolean?           @default(true) @map("is_primary_provider")
  failoverReason       String?            @map("failover_reason") @db.VarChar(255)
  providerVerified     Boolean?           @map("provider_verified")
  success              Boolean            @default(false)
  upstreamRequestId    String?            @map("upstream_request_id") @db.VarChar(128)
  errorCode            String?            @map("error_code") @db.VarChar(128)
  errorMessage         String?            @map("error_message") @db.Text
  errorBodyExcerpt     String?            @map("error_body_excerpt") @db.Text
  configVersion        Int?               @map("config_version")
  routeSnapshot        Json?              @map("route_snapshot")
  createdAt            DateTime           @default(now()) @map("created_at") @db.DateTime(3)

  task                 GenerationTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  game                 Game               @relation("GameLlmCallLogs", fields: [gameId], references: [id], onDelete: Cascade)
  user                 User               @relation("UserLlmCallLogs", fields: [userId], references: [id], onDelete: Cascade)
  provider             LlmGatewayProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([gameId, createdAt])
  @@index([stepKey, createdAt])
  @@map("llm_call_logs")
}

// ==================== 社交互动 ====================

enum InteractionTargetType {
  game
  user
  comment
}

enum InteractionAction {
  like
  follow
  play
  fork
  share
  report
}

model SocialInteraction {
  id         BigInt                @id @default(autoincrement())
  userId     String                @map("user_id") @db.VarChar(36)
  targetType InteractionTargetType @map("target_type")
  targetId   String                @map("target_id") @db.VarChar(36)
  action     InteractionAction
  metadata   Json?
  createdAt  DateTime              @default(now()) @map("created_at") @db.DateTime(3)

  user User  @relation("UserInteractions", fields: [userId], references: [id])

  @@unique([userId, targetType, targetId, action], name: "unique_interaction")
  @@index([targetType, targetId])
  @@index([userId, action])
  @@map("social_interactions")
}

model UserFollow {
  id          BigInt   @id @default(autoincrement())
  followerId  String   @map("follower_id") @db.VarChar(36)
  followingId String   @map("following_id") @db.VarChar(36)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  follower  User @relation("FollowerUser", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowingUser", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId], name: "unique_follow")
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
  @@map("user_follows")
}

// ==================== 评论系统 ====================

enum CommentStatus {
  visible
  hidden
  deleted
}

model Comment {
  id        String        @id @default(uuid()) @db.VarChar(36)
  gameId    String        @map("game_id") @db.VarChar(36)
  userId    String        @map("user_id") @db.VarChar(36)
  parentId  String?       @map("parent_id") @db.VarChar(36)
  content   String        @db.Text
  likeCount Int           @default(0) @map("like_count")
  status    CommentStatus @default(visible)
  createdAt DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  game    Game      @relation("GameComments", fields: [gameId], references: [id])
  user    User      @relation("UserComments", fields: [userId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([gameId, createdAt])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}

// ==================== 创作者收益 ====================

enum EarningType {
  ad_revenue
  tip
  prize
  referral
}

enum EarningStatus {
  pending
  settled
  withdrawn
}

model CreatorEarning {
  id          BigInt        @id @default(autoincrement())
  creatorId   String        @map("creator_id") @db.VarChar(36)
  gameId      String?       @map("game_id") @db.VarChar(36)
  earningType EarningType   @map("earning_type")
  amount      Decimal       @db.Decimal(12, 4)
  currency    String        @default("CNY") @db.VarChar(3)
  status      EarningStatus @default(pending)
  periodStart DateTime?     @map("period_start") @db.Date
  periodEnd   DateTime?     @map("period_end") @db.Date
  settledAt   DateTime?     @map("settled_at") @db.DateTime(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  creator User  @relation("CreatorEarnings", fields: [creatorId], references: [id])
  game    Game? @relation("GameEarnings", fields: [gameId], references: [id])

  @@index([creatorId, status])
  @@index([creatorId, createdAt])
  @@map("creator_earnings")
}

// ==================== 通知系统 ====================

enum NotificationType {
  like
  follow
  comment
  fork
  system
  challenge
  earning
}

model Notification {
  id        String           @id @default(uuid()) @db.VarChar(36)
  userId    String           @map("user_id") @db.VarChar(36)
  actorId   String?          @map("actor_id") @db.VarChar(36)
  type      NotificationType
  targetId  String?          @map("target_id") @db.VarChar(36)
  content   String?          @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation("UserNotifications", fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ==================== 系统配置 ====================

model SystemConfig {
  id          String   @id @default(uuid()) @db.VarChar(36)
  configKey   String   @unique @map("config_key") @db.VarChar(128)
  configValue String   @map("config_value") @db.LongText
  description String?  @db.VarChar(255)
  category    String   @default("general") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([category])
  @@map("system_configs")
}

enum AppReleasePlatform {
  ios
  android
}

enum AppReleaseSourceType {
  upload
  external_url
  app_store
}

enum AppReleaseStatus {
  draft
  published
  archived
}

model AppRelease {
  id             String               @id @default(uuid()) @db.VarChar(36)
  platform       AppReleasePlatform
  channel        String               @default("production") @db.VarChar(32)
  versionName    String               @map("version_name") @db.VarChar(64)
  buildNumber    String?              @map("build_number") @db.VarChar(64)
  releaseNotes   String?              @map("release_notes") @db.LongText
  downloadUrl    String?              @map("download_url") @db.VarChar(512)
  qrCodeUrl      String?              @map("qr_code_url") @db.VarChar(512)
  fileName       String?              @map("file_name") @db.VarChar(255)
  fileSize       BigInt?              @map("file_size")
  mimeType       String?              @map("mime_type") @db.VarChar(128)
  storageKey     String?              @map("storage_key") @db.VarChar(512)
  checksumSha256 String?              @map("checksum_sha256") @db.VarChar(64)
  sourceType     AppReleaseSourceType @default(upload) @map("source_type")
  status         AppReleaseStatus     @default(draft)
  isActive       Boolean              @default(false) @map("is_active")
  publishedAt    DateTime?            @map("published_at") @db.DateTime(3)
  createdBy      String?              @map("created_by") @db.VarChar(64)
  createdAt      DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([platform, channel, status])
  @@index([platform, channel, isActive])
  @@map("app_releases")
}

model AppPromoEvent {
  id        String   @id @default(uuid()) @db.VarChar(36)
  scene     String   @db.VarChar(64)
  eventType String   @map("event_type") @db.VarChar(64)
  userId    String?  @map("user_id") @db.VarChar(36)
  gameId    String?  @map("game_id") @db.VarChar(36)
  deviceId  String   @map("device_id") @db.VarChar(128)
  platform  String?  @db.VarChar(32)
  channel   String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  ipHash    String?  @map("ip_hash") @db.VarChar(128)
  extraJson Json?    @map("extra_json")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([scene, eventType, createdAt])
  @@index([platform, createdAt])
  @@index([deviceId, createdAt])
  @@map("app_promo_events")
}

model GenerationArtifact {
  id           String          @id @default(uuid()) @db.VarChar(36)
  taskId       String?         @map("task_id") @db.VarChar(36)
  gameId       String          @map("game_id") @db.VarChar(36)
  userId       String          @map("user_id") @db.VarChar(36)
  artifactType String          @map("artifact_type") @db.VarChar(64)
  contentType  String          @map("content_type") @db.VarChar(64)
  storageType  String          @map("storage_type") @db.VarChar(32)
  payloadJson  Json?           @map("payload_json")
  payloadText  String?         @map("payload_text") @db.LongText
  payloadUrl   String?         @map("payload_url") @db.VarChar(512)
  sha256       String?         @db.VarChar(64)
  sizeBytes    Int?            @map("size_bytes")
  compression  String?         @db.VarChar(32)
  expiresAt    DateTime?       @map("expires_at") @db.DateTime(3)
  metadata     Json?
  createdAt    DateTime        @default(now()) @map("created_at") @db.DateTime(3)

  task         GenerationTask? @relation("TaskGenerationArtifacts", fields: [taskId], references: [id], onDelete: SetNull)
  game         Game            @relation("GameGenerationArtifacts", fields: [gameId], references: [id], onDelete: Cascade)
  user         User            @relation("UserGenerationArtifacts", fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, artifactType, createdAt])
  @@index([gameId, artifactType, createdAt])
  @@index([userId, artifactType, createdAt])
  @@map("generation_artifacts")
}

model PromptBundle {
  id                     String   @db.VarChar(64)
  version                Int
  status                 String   @default("draft") @db.VarChar(16)
  productPolicy          String   @map("product_policy") @db.LongText
  lockedContractOverride String?  @map("locked_contract_override") @db.LongText
  repairPlaybook         String   @map("repair_playbook") @db.LongText
  profileOverrides       Json?    @map("profile_overrides")
  metadata               Json?
  createdAt              DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, version])
  @@index([status, updatedAt])
  @@map("prompt_bundles")
}

model RuntimeProfileCatalog {
  id              String   @id @db.VarChar(64)
  displayName     String   @map("display_name") @db.VarChar(128)
  enabled         Boolean  @default(true)
  skeletonVersion String   @map("skeleton_version") @db.VarChar(32)
  contractSchema  Json     @map("contract_schema")
  fewShotPrompt   String?  @map("few_shot_prompt") @db.LongText
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([enabled, updatedAt])
  @@map("runtime_profile_catalog")
}
