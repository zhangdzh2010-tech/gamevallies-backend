# ============================================================
# 火山引擎函数服务部署环境变量
# 用法:
#   cp .env.deploy.example .env.deploy
#   编辑 .env.deploy 填入实际值
#   source .env.deploy && python scripts/deploy.py
# ============================================================

# ── 火山引擎认证 ──────────────────────────────────────────
# 控制台 → 右上角头像 → 访问控制 → API 访问密钥 → 创建密钥
VOLCENGINE_ACCESS_KEY=your_access_key_here
VOLCENGINE_SECRET_KEY=your_secret_key_here

# ── 部署地域 ──────────────────────────────────────────────
# 你的函数服务所在地域，影响 API 签名中的 region 字段
# 可选值: cn-beijing / cn-shanghai / cn-guangzhou
VOLCENGINE_REGION=cn-shanghai

# ── 容器镜像仓库 (VCR) ────────────────────────────────────
# 登录命令: docker login cr.volces.com -u ACCESS_KEY -p SECRET_KEY
# 控制台 → 容器镜像服务 → 命名空间 → 创建命名空间（如 gamevallies）
VOLCENGINE_REGISTRY=cr.volces.com
VOLCENGINE_REGISTRY_NAMESPACE=your-namespace-here

# 镜像 Tag（本地测试保持 latest；CI 中由 github.sha 自动传入）
IMAGE_TAG=latest

# ── VPC / 子网 / 安全组 ───────────────────────────────────
# 控制台 → 私有网络 → VPC 列表 → 点进去复制 ID（格式: vpc-xxxxxxxxxx）
# 控制台 → 私有网络 → 子网列表 → 复制子网 ID（格式: subnet-xxxxxxxxxx）
# 控制台 → 私有网络 → 安全组 → 复制安全组 ID（格式: sg-xxxxxxxxxx）
# 三项全填才会启用 VPC 绑定；任一为空则跳过 VPC 配置（保留控制台设置）
VOLCENGINE_VPC_ID=vpc-1fui3r5jdt2bk1m79k8anl32c
VOLCENGINE_SUBNET_ID=subnet-1kse5at0gc9a859xbtim3pgrs
VOLCENGINE_SECURITY_GROUP_ID=sg-your_security_group_id_here

# ── 数据库 ────────────────────────────────────────────────
# 使用 RDS 内网地址（函数与 RDS 在同一 VPC 内才能访问）
# 外网地址仅用于本地初始化（prisma db push），上线后建议关闭
DATABASE_URL=mysql://gamevallies:your_password@mysql5f64263dff43.rds.ivolces.com:3306/gamevallies

# ── Redis ─────────────────────────────────────────────────
# 使用 Redis 内网地址（同 VPC 内访问）
REDIS_URL=redis://:your_password@redis-shzlsq69qwdo5877a.redis.ivolces.com:6379

# ── JWT 密钥 ──────────────────────────────────────────────
# 生成命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意: 上线后不可更换，否则所有用户 Token 失效
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# ── 跨域 ──────────────────────────────────────────────────
# 开发阶段用 *，上线后改为实际前端域名（如 https://gamevallies.com）
CORS_ORIGIN=*
