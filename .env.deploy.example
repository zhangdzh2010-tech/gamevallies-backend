# ============================================================
# 火山引擎函数服务部署环境变量
# 用法:
#   cp .env.deploy.example .env.deploy
#   编辑 .env.deploy 填入实际值
#   source .env.deploy && python scripts/deploy.py
# ============================================================

# 火山引擎认证（控制台 → 访问控制 → 密钥管理）
VOLCENGINE_ACCESS_KEY=your_access_key_here
VOLCENGINE_SECRET_KEY=your_secret_key_here
VOLCENGINE_REGION=cn-beijing

# VPC 配置（控制台 → 私有网络 → VPC 列表，复制 ID；子网同理）
# 配置后脚本会自动为函数设置 VPC，否则需手动在控制台设置
VOLCENGINE_VPC_ID=your_vpc_id_here
VOLCENGINE_SUBNET_ID=your_subnet_id_here

# 数据库（使用内网地址，外网仅用于本地初始化）
DATABASE_URL=mysql://gamevallies:your_password@mysql5f64263dff43.rds.ivolces.com:3306/gamevallies

# Redis（内网地址）
REDIS_URL=redis://:your_password@redis-shzlsq69qwdo5877a.redis.ivolces.com:6379

# JWT 密钥（运行 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成）
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# 跨域（上线后替换为实际域名，如 https://gamevallies.com）
CORS_ORIGIN=*
