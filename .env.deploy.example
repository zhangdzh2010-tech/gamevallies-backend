# ============================================================
# 火山引擎函数服务部署环境变量
# 用法:
#   cp .env.deploy.example .env.deploy
#   编辑 .env.deploy 填入实际值
#   source .env.deploy && python scripts/deploy.py
# ============================================================

# ── 火山引擎认证 ──────────────────────────────────────────
# 控制台 → 右上角头像 → 访问控制 → API 访问密钥 → 创建密钥
VOLCENGINE_ACCESS_KEY=your_access_key_here
VOLCENGINE_SECRET_KEY=your_secret_key_here

# ── 部署地域 ──────────────────────────────────────────────
VOLCENGINE_REGION=cn-shanghai
VOLCENGINE_API_HOST=open.volcengineapi.com

# ── VPC / 子网 / 安全组 ──────────────────────────────────
VOLCENGINE_VPC_ID=vpc-xxxxxxxxxx
VOLCENGINE_SUBNET_ID=subnet-xxxxxxxxxx
VOLCENGINE_SECURITY_GROUP_ID=sg-xxxxxxxxxx

# ── 容器镜像仓库 (VCR) ────────────────────────────────────
VOLCENGINE_REGISTRY=gamevallies-repo-cn-shanghai.cr.volces.com
VOLCENGINE_REGISTRY_NAMESPACE=gamevallies
IMAGE_TAG=latest
VOLCENGINE_REGISTRY_USERNAME="手机用户#xxxxx"
VOLCENGINE_REGISTRY_PASSWORD=your_vcr_password
VOLCENGINE_TOS_BUCKET=gamevallies-deploy

# ============================================================
# 服务公网 API 网关地址（面向用户/浏览器访问）
# 获取方式: 控制台 → 函数服务 → 对应函数 → 触发器 → 复制 URL
# ============================================================
FRONTEND_URL=https://www.gamevallies.com
USER_SERVICE_URL=https://your-user-service.apigateway-cn-shanghai.volceapi.com
GAME_SERVICE_URL=https://your-game-service.apigateway-cn-shanghai.volceapi.com
FEED_SERVICE_URL=https://your-feed-service.apigateway-cn-shanghai.volceapi.com

# ============================================================
# 服务内网 API 网关地址（服务间调用，仅 VPC 内可访问）
# 将公网地址中 apigateway-cn-shanghai 改为 apigateway-cn-shanghai-inner
# ============================================================
AI_ENGINE_URL=https://your-ai-engine.apigateway-cn-shanghai-inner.volceapi.com

# ============================================================
# 数据库（VPC 内网地址）
# ============================================================
DATABASE_URL=mysql://gamevallies:your_password@your-rds-host.rds.ivolces.com:3306/gamevallies
REDIS_URL=redis://:your_password@your-redis-host.redis.ivolces.com:6379

# ============================================================
# JWT 密钥
# 生成命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意: 上线后不可更换，否则所有用户 Token 失效
# ============================================================
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# ── 跨域 ──────────────────────────────────────────────────
# 开发阶段用 *，上线后改为实际前端域名
CORS_ORIGIN=*

# ============================================================
# AI 引擎 / MiniMax
# ============================================================
LLM_API_KEY=your_minimax_api_key_here
LLM_BASE_URL=https://api.minimaxi.com
LLM_MODEL=MiniMax-M2.5
LLM_FAST_MODEL=MiniMax-M2.5
LLM_MODE=real

# ============================================================
# 阿里云号码认证 / 短信服务
# ============================================================
ALIYUN_ACCESS_KEY_ID=your_aliyun_ak_here
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_sk_here
ALIYUN_REGION_ID=cn-hangzhou
ALIYUN_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=your_sms_sign_name
ALIYUN_SMS_TEMPLATE_CODE=your_template_code
