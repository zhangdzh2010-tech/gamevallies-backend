# ============================================================
# GameVallies backend deployment environment example
# Copy to .env.deploy and replace secrets before deploying.
# ============================================================

# Volcengine account
VOLCENGINE_ACCESS_KEY=your_access_key_here
VOLCENGINE_SECRET_KEY=your_secret_key_here
VOLCENGINE_REGION=cn-shanghai
VOLCENGINE_API_HOST=open.volcengineapi.com

# Network
VOLCENGINE_VPC_ID=vpc-xxxxxxxxxx
VOLCENGINE_SUBNET_ID=subnet-xxxxxxxxxx
VOLCENGINE_SECURITY_GROUP_ID=sg-xxxxxxxxxx
VOLCENGINE_VPC_ID_CN_SHANGHAI=vpc-xxxxxxxxxx
VOLCENGINE_SUBNET_ID_CN_SHANGHAI=subnet-xxxxxxxxxx
VOLCENGINE_SECURITY_GROUP_ID_CN_SHANGHAI=sg-xxxxxxxxxx
VOLCENGINE_VPC_ID_AP_SOUTHEAST_JOHOR=vpc-yyyyyyyyyy
VOLCENGINE_SUBNET_ID_AP_SOUTHEAST_JOHOR=subnet-yyyyyyyyyy
VOLCENGINE_SECURITY_GROUP_ID_AP_SOUTHEAST_JOHOR=sg-yyyyyyyyyy

# VCR
VOLCENGINE_REGISTRY=gamevallies-repo-cn-shanghai.cr.volces.com
VOLCENGINE_REGISTRY_CN_SHANGHAI=gamevallies-repo-cn-shanghai.cr.volces.com
VOLCENGINE_REGISTRY_AP_SOUTHEAST_JOHOR=gamevallies-repo-ap-southeast-johor.cr.volces.com
VOLCENGINE_REGISTRY_NAMESPACE=gamevallies
VOLCENGINE_REGISTRY_USERNAME="手机用户#xxxxx"
VOLCENGINE_REGISTRY_PASSWORD=your_vcr_password
VOLCENGINE_TOS_BUCKET=gamevallies-deploy
IMAGE_TAG=release-YYYYMMDD-HHMMSS

# Unified public entry
FRONTEND_URL=https://gamevallies.com
PUBLIC_API_BASE_URL=https://gamevallies.com
USER_SERVICE_URL=https://gamevallies.com
GAME_SERVICE_URL=https://gamevallies.com
FEED_SERVICE_URL=https://gamevallies.com

# Private upstreams inside VPC
# AI_ENGINE_URL is a compatibility fallback. Keep it aligned with the current default region endpoint.
AI_ENGINE_URL=https://your-ai-engine-cn.apigateway-cn-shanghai-inner.volceapi.com
AI_ENGINE_URL_CN_SHANGHAI=https://your-ai-engine-cn.apigateway-cn-shanghai-inner.volceapi.com
AI_ENGINE_URL_AP_SOUTHEAST_JOHOR=https://your-ai-engine-global.apigateway-ap-southeast-johor-inner.volceapi.com
AI_ENGINE_DEFAULT_REGION=cn_shanghai
GAME_SERVICE_UPSTREAM_URL=https://your-game-service.apigateway-cn-shanghai-inner.volceapi.com
FEED_SERVICE_UPSTREAM_URL=https://your-feed-service.apigateway-cn-shanghai-inner.volceapi.com

# Runtime
NODE_ENV=production
PORT=3001
CORS_ORIGIN=*
ADMIN_TOKEN=admin123
DATABASE_URL=mysql://gamevallies:your_password@your-rds-host.rds.ivolces.com:3306/gamevallies
REDIS_URL=redis://:your_password@your-redis-host.redis.ivolces.com:6379
JWT_SECRET=REMOVED_CREDENTIAL
JWT_REFRESH_SECRET=REMOVED_CREDENTIAL

# WeChat miniapp
WECHAT_MINIAPP_APP_ID=your_wechat_miniapp_app_id
WECHAT_MINIAPP_APP_SECRET=your_wechat_miniapp_app_secret
WECHAT_PAY_MODE=real
WECHAT_PAY_MERCHANT_ID=your_wechat_mchid
WECHAT_PAY_NOTIFY_URL=https://gamevallies.com/api/v1/subscription/wechat/notify
WECHAT_PAY_SERIAL_NO=your_api_cert_serial
# Runtime image does not include docs/integration/微信支付, so production should inject inline PEM values.
WECHAT_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
WECHAT_PAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
WECHAT_PAY_API_V3_KEY=your_apiv3_key
WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com
BILLING_DEFAULT_FREE_QUOTA=5

# Aliyun SMS for user-service
ALIYUN_ACCESS_KEY_ID=your_aliyun_ak
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_sk
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_SIGN_NAME=智了科技
ALIYUN_SMS_TPL_REGISTER=SMS_503430059
ALIYUN_SMS_TPL_LOGIN=SMS_503470064
ALIYUN_SMS_TPL_RESET_PASSWORD=SMS_503470064
VERIFY_CODE_SEND_INTERVAL_SECONDS=60
VEFAAS_USER_SERVICE_MIN_INSTANCE=0
VEFAAS_USER_SERVICE_MAX_INSTANCE=20
# Optional: keep a small number of frozen instances for burst traffic / cold-start control.
# VEFAAS_USER_SERVICE_RESERVED_FROZEN_INSTANCE=1

# AI engine deployment
VOLCENGINE_REGION_CN_SHANGHAI=cn-shanghai
VOLCENGINE_REGION_AP_SOUTHEAST_JOHOR=ap-southeast-johor
AI_ENGINE_FUNCTION_NAME_CN_SHANGHAI=gv-ai-engine-cn
AI_ENGINE_FUNCTION_NAME_AP_SOUTHEAST_JOHOR=gv-ai-engine-global
LLM_MODE=real
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M2.5
LLM_FAST_MODEL=MiniMax-M2.5
PIPELINE_TIMEOUT_S=600
SERVICE_REGION=cn-shanghai
LLM_GATEWAY_CACHE_TTL_S=10
