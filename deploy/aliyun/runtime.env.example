# Copy to /opt/gamevallies/backend/runtime.env on ECS, mode 600.
DATABASE_URL=mysql://USER:PASSWORD@RDS_PRIVATE_HOST:3306/gamevallies
REDIS_URL=redis://:PASSWORD@REDIS_PRIVATE_HOST:6379/0
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
ADMIN_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN
CORS_ORIGIN=https://app.example.com
CORS_ORIGINS=["https://app.example.com"]
FRONTEND_URL=https://app.example.com
PUBLIC_API_BASE_URL=https://app.example.com
USER_SERVICE_URL=https://app.example.com
GAME_SERVICE_URL=https://app.example.com
FEED_SERVICE_URL=https://app.example.com
APP_URL=https://app.example.com
LLM_MODE=real
LLM_API_KEY=REPLACE_WITH_MODEL_KEY
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M2.5
LLM_FAST_MODEL=MiniMax-M2.5
# Add the SMS, WeChat and Alipay settings actually used by your account.
# BUNDLE_CDN_ENABLED=false uses the application game route; existing object
# storage integrations require separate credentials and data migration planning.
BUNDLE_CDN_ENABLED=false
