{
  "name": "gamevallies-backend",
  "version": "1.0.0",
  "private": true,
  "description": "PlayForge Backend - AI-Powered Game Creation Platform",
  "workspaces": [
    "packages/platform-config",
    "packages/user-service",
    "packages/feed-service",
    "packages/game-service",
    "packages/social-service"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:user": "npm run dev --workspace=packages/user-service",
    "dev:game": "npm run build --workspace=packages/user-service && npm run build --workspace=packages/feed-service && npm run start:dev --workspace=packages/game-service",
    "dev:social": "npm run dev --workspace=packages/social-service",
    "dev:feed": "npm run dev --workspace=packages/feed-service",
    "dev:ai": "cd packages/ai-engine && uvicorn src.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:all": "concurrently \"npm run dev:game\" \"npm run dev:ai\"",
    "test": "npm run test --workspaces",
    "test:cov": "npm run test:cov --workspaces",
    "lint": "eslint 'packages/*/src/**/*.ts'",
    "lint:fix": "eslint 'packages/*/src/**/*.ts' --fix",
    "format": "prettier --write 'packages/*/src/**/*.ts'",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:seed": "npx ts-node prisma/seed.ts",
    "db:init-games": "npx ts-node scripts/init-games.ts",
    "db:init-premium": "npx ts-node scripts/init-premium-games.ts",
    "docker:build": "bash scripts/build-docker.sh all",
    "docker:build:user": "bash scripts/build-docker.sh user-service",
    "docker:build:game": "bash scripts/build-docker.sh game-service",
    "docker:build:social": "bash scripts/build-docker.sh social-service",
    "docker:build:feed": "bash scripts/build-docker.sh feed-service",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\"",
    "type-check": "npm run build --workspaces",
    "test:unit": "npm run test --workspaces --if-present --",
    "test:integration": "jest --config jest.integration.config.js --runInBand"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "^4.5.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@prisma/client": "^5.10.0",
    "prisma": "^5.10.0",
    "reflect-metadata": "^0.2.1"
  }
}
