# Game Service – Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

NODE_ENV=development
PORT=3002

# ── Database (MySQL + Redis) ──────────────────────────────────────────────
DATABASE_URL=mysql://root:password@localhost:3306/gamevallies
REDIS_URL=redis://:password@localhost:6379

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── Service URLs ───────────────────────────────────────────────────────────
AI_ENGINE_URL=http://localhost:8000
# Base URL used to construct game preview links
APP_URL=http://localhost:3002
PUBLIC_API_BASE_URL=http://localhost:3002
# Local directory for uploaded Android release packages
APP_RELEASE_UPLOAD_DIR=files/app-releases
TOS_BUCKET=
TOS_ENDPOINT=https://tos-cn-shanghai.volces.com
APP_RELEASE_TOS_PREFIX=app-releases
APP_RELEASE_TOS_SIGNED_URL_EXPIRES=600
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
VOLCENGINE_REGION=cn-shanghai

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGIN=*
