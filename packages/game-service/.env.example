# Game Service – Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

NODE_ENV=development
PORT=3002

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://gamevallies:password@localhost:5432/gamevallies
MONGO_URL=mongodb://gamevallies:password@localhost:27017/gamevallies?authSource=admin
REDIS_URL=redis://:password@localhost:6379

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── Service URLs ───────────────────────────────────────────────────────────
AI_ENGINE_URL=http://localhost:8000
# Base URL used to construct game preview links
APP_URL=http://localhost:3002

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGIN=*
