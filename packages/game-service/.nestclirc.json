{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "tsc",
    "typeCheck": true,
    "assets": [
      {
        "include": "admin/**/*.html",
        "watchAssets": true
      },
      {
        "include": "admin/**/*.css",
        "watchAssets": true
      },
      {
        "include": "admin/**/*.js",
        "watchAssets": true
      },
      {
        "include": "game/**/*.html",
        "watchAssets": true
      }
    ]
  }
}
