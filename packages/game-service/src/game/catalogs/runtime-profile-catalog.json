    "id": "portrait_arcade",
    "displayName": "Portrait Arcade",
    "skeletonVersion": "v1",
    "contractSchema": {
      "runtimeProfile": "portrait_arcade",
      "inputContract": {
        "requiredModes": ["pointer", "touch"],
        "allowMouseFallback": true,
        "target": "canvas_or_document"
      },
      "stateContract": {
        "requiredStates": ["boot", "ready", "playing", "game_over"],
        "restartable": true
      },
      "renderContract": {
        "requiresCanvas2D": true,
        "mustRenderWithinMs": 1500
      },
      "mobileLayoutContract": {
        "orientation": "portrait_first",
        "uiScaleMode": "short_edge",
        "fontClamp": {
          "hudMin": 14,
          "hudMax": 20,
          "titleMin": 28,
          "titleMax": 36
        }
      },
      "safetyContract": {
        "forbiddenApis": ["localStorage", "sessionStorage", "fetch", "XMLHttpRequest", "WebSocket", "eval", "Function"]
      }
    },
    "fewShotPrompt": "Use a centered portrait canvas, compact HUD, one obvious primary interaction, and a visible restart path. Render one obvious player, target, or playfield element before input. If a ready overlay exists, the same tap on the playfield should dismiss it and start play immediately.",
    "metadata": {
      "category": "arcade",
      "default": true
    }
  },
