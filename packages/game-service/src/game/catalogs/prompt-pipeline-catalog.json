{
  "steps": [
    {
      "id": "step1_intent_freeze",
      "stepNumber": 1,
      "tag": "Step 1",
      "title": "Prompt Expansion & Intent Freeze",
      "description": "Expand the user brief into a confirmable prompt, then lock the confirmed brief into the intent JSON contract.",
      "color": "#7c3aed",
      "bg": "#f5f3ff",
      "border": "#ddd6fe",
      "promptKeys": [
        "prompt.expand_prompt_system",
        "prompt.intent_parse_system",
        "prompt.slot_output_contract",
        "prompt.slot_json_repair_system",
        "prompt.slot_json_repair_user_template"
      ],
      "support": []
    },
    {
      "id": "step2_spec_contract",
      "stepNumber": 2,
      "tag": "Step 2",
      "title": "Spec 编排与运行时约束",
      "description": "把意图压成结构化 spec、runtime contract 和 few-shot 约束。",
      "color": "#0f766e",
      "bg": "#ecfeff",
      "border": "#99f6e4",
      "promptKeys": [
        "prompt.intent_detail_template",
        "prompt.runtime_contract_summary",
        "prompt.mobile_layout_guardrails",
        "prompt.iteration_spec_context_template",
        "bundle.product.intent_parse",
        "bundle.runtime.profile.casual_arcade",
        "bundle.runtime.profile.casual_lane",
        "bundle.runtime.profile.puzzle_grid",
        "bundle.runtime.profile.casual_action",
        "bundle.runtime.profile.tap_challenge"
      ],
      "support": [
        {
          "kind": "runtime_profiles",
          "title": "Runtime Profiles",
          "description": "few-shot prompt 和 contract schema 的 live catalog。"
        }
      ]
    },
    {
      "id": "step3_code_synthesis",
      "stepNumber": 3,
      "tag": "Step 3",
      "title": "代码合成",
      "description": "GDD、request context、bundle policy 一起驱动代码生成。",
      "color": "#2563eb",
      "bg": "#eff6ff",
      "border": "#bfdbfe",
      "promptKeys": [
        "prompt.game_design_template",
        "prompt.code_gen_system",
        "prompt.generate_request_context_template",
        "prompt.generate_alignment_reminder",
        "bundle.runtime.locked_contract",
        "bundle.product.policy",
        "bundle.product.logic_generate"
      ],
      "support": [
        {
          "kind": "prompt_bundle_policy",
          "title": "Live Prompt Bundle",
          "description": "product policy / locked contract override / profile overrides。"
        }
      ]
    },
    {
      "id": "step4_issue_repair",
      "stepNumber": 4,
      "tag": "Step 4",
      "title": "IssueList 与有限修复",
      "description": "QA issue family、review 和 targeted repair 的统一层。",
      "color": "#d97706",
      "bg": "#fffbeb",
      "border": "#fde68a",
      "promptKeys": [
        "prompt.code_review_system",
        "prompt.code_review_template",
        "prompt.qa_runtime_contract_block",
        "bundle.repair.syntax_structural"
      ],
      "support": [
        {
          "kind": "prompt_bundle_repair",
          "title": "Live Repair Playbook",
          "description": "active prompt bundle 的 repair playbook live override。"
        }
      ]
    },
    {
      "id": "step5_finalize",
      "stepNumber": 5,
      "tag": "Step 5",
      "title": "Finalizer 与产物固化",
      "description": "当前 Step 5 主要是 deterministic finalize，没有独立 prompt 层。",
      "color": "#e11d48",
      "bg": "#fff1f2",
      "border": "#fecdd3",
      "promptKeys": [],
      "support": [
        {
          "kind": "deterministic_note",
          "title": "Deterministic Finalizer",
          "description": "bundle / artifact / task finalize 目前不走独立 LLM prompt。"
        }
      ]
    }
  ],
  "extras": [
    {
      "id": "extra_iterate",
      "tag": "附加",
      "title": "迭代链路",
      "description": "不属于核心五步 create 主链，但仍由后台统一管理。",
      "color": "#7c2d12",
      "bg": "#fff7ed",
      "border": "#fdba74",
      "promptKeys": [
        "prompt.iterate_classify",
        "prompt.param_adjust",
        "prompt.element_change",
        "prompt.mechanic_change"
      ]
    },
    {
      "id": "extra_legacy_fallbacks",
      "tag": "Legacy",
      "title": "Legacy fallback prompts",
      "description": "Compatibility prompts that are only used when newer owner prompts do not provide the required constraints.",
      "color": "#6b7280",
      "bg": "#f9fafb",
      "border": "#d1d5db",
      "promptKeys": ["prompt.platform_standard"]
    }
  ],
