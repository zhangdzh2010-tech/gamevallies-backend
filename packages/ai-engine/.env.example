# AI Engine – Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

ENVIRONMENT=development
PORT=8000

# ── Database (MySQL + Redis) ──────────────────────────────────────────────
DATABASE_URL=mysql://root:password@localhost:3306/gamevallies
REDIS_URL=redis://:password@localhost:6379

# ── LLM Mode ──────────────────────────────────────────────────────────────
# mock  → keyword rules + templates, no API key needed (for local dev / CI)
# real  → provider-backed LLM path
LLM_MODE=mock

# ── OpenAI-Compatible Provider (MiniMax / OpenAI / etc.) ──────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M2.5
LLM_FAST_MODEL=MiniMax-M2.5

# ── Anthropic / Claude (optional fallback) ─────────────────────────────────
ANTHROPIC_API_KEY=
# Models (defaults work, only change if you need to pin a different version)
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001

# ── Pipeline Tuning ────────────────────────────────────────────────────────
# Max QA auto-fix retries when generated code fails validation
QA_MAX_RETRIES=3
# Hard pipeline timeout in seconds (enforced by asyncio.wait_for).
# Real-model full pipeline runs can be long, so align with deploy default.
PIPELINE_TIMEOUT_S=1800
# In production, runtime QA should not be silently skipped.
RUNTIME_QA_REQUIRED=true
# Runtime QA browser smoke-test timeout in seconds.
RUNTIME_QA_TIMEOUT_S=8
# Max iteration rounds allowed per game
MAX_ITERATIONS=20

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=["*"]

# ── Gateway / Upstream Sync ───────────────────────────────────────────────
GAME_SERVICE_UPSTREAM_URL=http://localhost:3002
SERVICE_REGION=global
LLM_GATEWAY_CACHE_TTL_S=10
