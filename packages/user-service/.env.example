# User Service – Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

NODE_ENV=development
PORT=3001

# ── Database (MySQL + Redis) ──────────────────────────────────────────────
DATABASE_URL=mysql://root:password@localhost:3306/gamevallies
REDIS_URL=redis://:password@localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated or JSON. Production should include www and apex:
# CORS_ORIGIN=https://www.zlspace.ai,https://zlspace.ai
CORS_ORIGIN=*
PUBLIC_API_BASE_URL=https://www.zlspace.ai
PUBLIC_WEB_BASE_URL=https://www.zlspace.ai

# ── Payments (see repo-root .env.example for the full list) ───────────────
# Notify routes are BillingController + global prefix api/v1:
#   POST /api/v1/subscription/wechat/notify
#   POST /api/v1/subscription/alipay/notify
WECHAT_PAY_MODE=mock
WECHAT_PAY_NOTIFY_URL=https://www.zlspace.ai/api/v1/subscription/wechat/notify
ALIPAY_MODE=mock
ALIPAY_NOTIFY_URL=https://www.zlspace.ai/api/v1/subscription/alipay/notify
# Local credential pack from 凭据.zip can stay as .env.payments.local.
# Canonical names are preferred; zltokens aliases are accepted as fallbacks:
# WECHAT_MCH_ID, WECHAT_API_V3_KEY, WECHAT_CERT_SERIAL, WECHAT_APP_ID

