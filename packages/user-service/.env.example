# User Service – Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

NODE_ENV=development
PORT=3001

# ── Database (MySQL + Redis) ──────────────────────────────────────────────
DATABASE_URL=mysql://root:password@localhost:3306/gamevallies
REDIS_URL=redis://:password@localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated or JSON. Production should include www and apex:
# CORS_ORIGIN=https://www.zlspace.ai,https://zlspace.ai
CORS_ORIGIN=*
