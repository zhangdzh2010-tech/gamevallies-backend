# Social Service – Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

NODE_ENV=development
PORT=3003

# ── Database (MySQL + Redis) ──────────────────────────────────────────────
DATABASE_URL=mysql://root:password@localhost:3306/gamevallies
REDIS_URL=redis://:password@localhost:6379

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── CORS ──────────────────────────────────────────────────────────────────
# Production allowlist includes www and apex; credentials stay enabled.
# CORS_ORIGIN=https://www.zlspace.ai,https://zlspace.ai
CORS_ORIGIN=*
