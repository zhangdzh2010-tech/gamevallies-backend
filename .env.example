# Backend runtime environment example

NODE_ENV=production
PORT=3001
CORS_ORIGIN=*
ADMIN_TOKEN=admin123

DATABASE_URL=mysql://<user>:<password>@<host>:3306/gamevallies
REDIS_URL=redis://:<password>@<host>:6379

JWT_SECRET=REMOVED_CREDENTIAL
JWT_REFRESH_SECRET=REMOVED_CREDENTIAL

PUBLIC_API_BASE_URL=https://gamevallies.com
USER_SERVICE_URL=https://gamevallies.com
GAME_SERVICE_URL=https://gamevallies.com
FEED_SERVICE_URL=https://gamevallies.com
AI_ENGINE_URL=https://<ai-engine-cn>.apigateway-cn-shanghai-inner.volceapi.com
AI_ENGINE_URL_CN_SHANGHAI=https://<ai-engine-cn>.apigateway-cn-shanghai-inner.volceapi.com
AI_ENGINE_DEFAULT_REGION=cn_shanghai
GAME_SERVICE_UPSTREAM_URL=https://<game-service>.apigateway-cn-shanghai-inner.volceapi.com
FEED_SERVICE_UPSTREAM_URL=https://<feed-service>.apigateway-cn-shanghai-inner.volceapi.com
SERVICE_REGION=cn-shanghai
LLM_GATEWAY_CACHE_TTL_S=10

ALIYUN_ACCESS_KEY_ID=replace_me
ALIYUN_ACCESS_KEY_SECRET=replace_me
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_SIGN_NAME=智了科技
ALIYUN_SMS_TPL_REGISTER=SMS_503430059
ALIYUN_SMS_TPL_LOGIN=SMS_503470064
ALIYUN_SMS_TPL_RESET_PASSWORD=SMS_503470064
VERIFY_CODE_SEND_INTERVAL_SECONDS=60

WECHAT_MINIAPP_APP_ID=replace_me
WECHAT_MINIAPP_APP_SECRET=replace_me
WECHAT_PAY_MODE=mock
WECHAT_PAY_MERCHANT_ID=replace_me
WECHAT_PAY_NOTIFY_URL=https://gamevallies.com/api/v1/subscription/wechat/notify
WECHAT_PAY_SERIAL_NO=replace_me
# Cloud deploys should prefer inline PEM content. Local development may use *_PATH.
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=docs/integration/微信支付/apiclient_key.pem
WECHAT_PAY_PUBLIC_KEY_PATH=docs/integration/微信支付/pub_key.pem
WECHAT_PAY_API_V3_KEY=replace_me
WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com
ALIPAY_MODE=real
ALIPAY_APP_ID=2021006144605202
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=TODO_REPLACE_WITH_ALIPAY_PUBLIC_KEY
ALIPAY_NOTIFY_URL=https://gamevallies.com/api/v1/subscription/alipay/notify
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_SELLER_ID=
BILLING_DEFAULT_FREE_QUOTA=5

# Optional for ai-engine local runtime
LLM_MODE=real
LLM_API_KEY=replace_me
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_FAST_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001
