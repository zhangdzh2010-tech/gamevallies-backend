# Backend runtime environment example

NODE_ENV=production
PORT=3001
# Local default is open. Production FC injects www + apex; keep credentials enabled.
# CORS_ORIGIN=https://www.zlspace.ai,https://zlspace.ai
# CORS_ORIGINS=["https://www.zlspace.ai","https://zlspace.ai"]
CORS_ORIGIN=*
ADMIN_TOKEN=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

DATABASE_URL=mysql://CHANGE_ME:CHANGE_ME@localhost:3306/gamevallies
REDIS_URL=redis://localhost:6379

JWT_SECRET=
JWT_REFRESH_SECRET=

PUBLIC_API_BASE_URL=https://www.zlspace.ai
PUBLIC_WEB_BASE_URL=https://www.zlspace.ai
USER_SERVICE_URL=https://www.zlspace.ai
GAME_SERVICE_URL=https://www.zlspace.ai
FEED_SERVICE_URL=https://www.zlspace.ai
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_URL_CN_SHANGHAI=http://localhost:8000
AI_ENGINE_DEFAULT_REGION=cn_shanghai
GAME_SERVICE_UPSTREAM_URL=http://localhost:3002
FEED_SERVICE_UPSTREAM_URL=http://localhost:3004
SERVICE_REGION=cn-shanghai
LLM_GATEWAY_CACHE_TTL_S=10

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_SIGN_NAME=智了科技
ALIYUN_SMS_TPL_REGISTER=SMS_503430059
ALIYUN_SMS_TPL_LOGIN=SMS_503470064
ALIYUN_SMS_TPL_RESET_PASSWORD=SMS_503470064
VERIFY_CODE_SEND_INTERVAL_SECONDS=60

WECHAT_MINIAPP_APP_ID=replace_me
WECHAT_MINIAPP_APP_SECRET=
WECHAT_H5_APP_ID=replace_me
WECHAT_H5_APP_SECRET=
WECHAT_H5_OAUTH_SCOPE=snsapi_base
# Production GitHub Secrets should set WECHAT_PAY_MODE=real and ALIPAY_MODE=real.
# Local default stays mock so a copied .env cannot charge live merchants.
WECHAT_PAY_MODE=mock
WECHAT_PAY_MERCHANT_ID=replace_me
# Must match BillingController + global prefix api/v1:
# POST /api/v1/subscription/wechat/notify
WECHAT_PAY_NOTIFY_URL=https://www.zlspace.ai/api/v1/subscription/wechat/notify
WECHAT_PAY_SERIAL_NO=replace_me
# Cloud deploys should prefer inline PEM content. Local development may use *_PATH.
# Keep real PEMs in secrets/ or .env.payments.local — never commit them.
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=secrets/apiclient_key.pem
WECHAT_PAY_PUBLIC_KEY_PATH=secrets/pub_key.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com
# Optional zltokens-pack aliases (used only when the canonical key is empty):
# WECHAT_MCH_ID → WECHAT_PAY_MERCHANT_ID
# WECHAT_API_V3_KEY → WECHAT_PAY_API_V3_KEY
# WECHAT_CERT_SERIAL → WECHAT_PAY_SERIAL_NO
# WECHAT_APP_ID → WECHAT_H5_APP_ID and WECHAT_MINIAPP_APP_ID
ALIPAY_MODE=mock
ALIPAY_APP_ID=replace_me
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# POST /api/v1/subscription/alipay/notify
ALIPAY_NOTIFY_URL=https://www.zlspace.ai/api/v1/subscription/alipay/notify
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_SELLER_ID=
BILLING_DEFAULT_FREE_QUOTA=5

# Optional for ai-engine local runtime
LLM_MODE=real
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_FAST_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001
