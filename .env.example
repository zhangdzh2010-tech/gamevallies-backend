# ============================================================
# PlayForge Environment Configuration Template
# Copy this file to .env and fill in the actual values
# IMPORTANT: Never commit .env file to Git!
# ============================================================

# ============================================================
# Environment
# ============================================================
NODE_ENV=development
LOG_LEVEL=info

# ============================================================
# Database Configuration (MySQL 8.0 + Redis)
# ============================================================
DATABASE_URL="mysql://root:change_me_password@localhost:3306/gamevallies"
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me_password
MYSQL_DB=gamevallies

# Redis (Caching and sessions)
REDIS_URL="redis://:change_me_password@localhost:6379/0"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_password
REDIS_DB=0

# ============================================================
# API Configuration
# ============================================================
API_PORT=3000
API_HOST=0.0.0.0
API_VERSION=v1
API_BASE_URL=http://localhost:3000

# ============================================================
# Service URLs (for inter-service communication)
# ============================================================
USER_SERVICE_URL=http://localhost:3001
GAME_SERVICE_URL=http://localhost:3002
SOCIAL_SERVICE_URL=http://localhost:3003
FEED_SERVICE_URL=http://localhost:3004
AI_ENGINE_URL=http://localhost:8000

# ============================================================
# Authentication & Security
# ============================================================
JWT_SECRET=your-256-bit-secret-key-change-me-in-production
JWT_REFRESH_SECRET=your-256-bit-refresh-secret-key-change-me
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d
INTERNAL_API_KEY=internal-service-auth-key-change-me

# ============================================================
# External APIs
# ============================================================
# LLM API for AI Engine (DeepSeek / OpenAI / Anthropic)
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_FAST_MODEL=deepseek-chat
LLM_MODE=real

# ============================================================
# Email Configuration
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@playforge.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@playforge.com

# ============================================================
# Payment Gateway (Stripe)
# ============================================================
STRIPE_SECRET_KEY=sk_test_your-key-here
STRIPE_PUBLIC_KEY=pk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here

# ============================================================
# AWS Configuration (S3 for game assets)
# ============================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=gamevallies-assets
AWS_S3_URL=https://gamevallies-assets.s3.amazonaws.com

# ============================================================
# Error Tracking (Sentry)
# ============================================================
SENTRY_DSN=https://key@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================
# Monitoring and Observability
# ============================================================
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=false
TRACING_JAEGER_HOST=localhost
TRACING_JAEGER_PORT=6831

# ============================================================
# Feature Flags
# ============================================================
FEATURE_AI_ENABLED=true
FEATURE_MULTIPLAYER_ENABLED=true
FEATURE_IN_APP_PURCHASE_ENABLED=true
FEATURE_SOCIAL_ENABLED=true
FEATURE_LEADERBOARD_ENABLED=true

# ============================================================
# Cache Configuration
# ============================================================
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
CACHE_STRATEGY=lru  # lru, lfu, fifo

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_ENABLED=true

# ============================================================
# CORS Configuration
# ============================================================
CORS_ORIGIN=*
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# ============================================================
# WebSocket Configuration
# ============================================================
WEBSOCKET_ENABLED=true
WEBSOCKET_PING_INTERVAL=30000
WEBSOCKET_TIMEOUT=3600000

# ============================================================
# Pagination
# ============================================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ============================================================
# File Upload
# ============================================================
MAX_FILE_SIZE=52428800  # 50MB in bytes
ALLOWED_FILE_TYPES=png,jpg,jpeg,gif,webp,mp3,wav,ogg
UPLOAD_DIR=/tmp/uploads

# ============================================================
# Admin Credentials (Development Only)
# ============================================================
ADMIN_EMAIL=admin@playforge.com
ADMIN_PASSWORD=change_me_secure_password

# ============================================================
# Development Tools
# ============================================================
DEBUG=playforge:*
VERBOSE_LOGGING=false
MOCK_LLM_RESPONSES=false  # For development without real LLM API
