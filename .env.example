# Backend runtime environment example

NODE_ENV=production
PORT=3001
CORS_ORIGIN=*
ADMIN_TOKEN=admin123

DATABASE_URL=mysql://<user>:<password>@<host>:3306/gamevallies
REDIS_URL=redis://:<password>@<host>:6379

JWT_SECRET=REMOVED_CREDENTIAL
JWT_REFRESH_SECRET=REMOVED_CREDENTIAL

PUBLIC_API_BASE_URL=https://www.gamevallies.com
USER_SERVICE_URL=https://www.gamevallies.com
GAME_SERVICE_URL=https://www.gamevallies.com
FEED_SERVICE_URL=https://www.gamevallies.com
AI_ENGINE_URL=https://<ai-engine>.apigateway-cn-shanghai-inner.volceapi.com
GAME_SERVICE_UPSTREAM_URL=https://<game-service>.apigateway-cn-shanghai-inner.volceapi.com
FEED_SERVICE_UPSTREAM_URL=https://<feed-service>.apigateway-cn-shanghai-inner.volceapi.com

ALIYUN_ACCESS_KEY_ID=replace_me
ALIYUN_ACCESS_KEY_SECRET=replace_me
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_SIGN_NAME=智了科技
ALIYUN_SMS_TPL_REGISTER=SMS_503430059
ALIYUN_SMS_TPL_LOGIN=SMS_503470064
VERIFY_CODE_SEND_INTERVAL_SECONDS=60

WECHAT_MINIAPP_APP_ID=replace_me
WECHAT_MINIAPP_APP_SECRET=replace_me

# Optional for ai-engine local runtime
LLM_MODE=real
LLM_API_KEY=replace_me
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_FAST_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
